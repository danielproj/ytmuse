<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Applied only by scripts/sign-bundle.sh with an identity ($(TeamIdentifierPrefix) is filled in from the identity's team). Xcode's own signing uses NativeMusicWidget-adhoc.entitlements. -->
<plist version="1.0"><dict>
    <key>com.apple.security.app-sandbox</key><true/>
    <key>com.apple.security.application-groups</key><array><string>$(TeamIdentifierPrefix)local.native-music.development</string></array>
</dict></plist>
