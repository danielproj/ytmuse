          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved window state could not be reset safely. Your account remains usable. Try again after fixing this app’s window-state storage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudo restablecer de forma segura el estado guardado de las ventanas. Tu cuenta sigue siendo utilizable. Inténtalo de nuevo después de arreglar el almacenamiento del estado de ventanas de esta app."
          }
        },
        "fr": {
          "stringUnit": {
