          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filters require this radio’s active player, readable queue and supported playback options. Restart the radio to reload its controls."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los filtros necesitan el reproductor activo de esta radio, una cola legible y opciones de reproducción compatibles. Reinicia la radio para recargar sus controles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les filtres nécessitent le lecteur actif de cette radio, une file lisible et des options de lecture prises en charge. Redémarrez la radio pour recharger ses commandes."
