        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jeder Account wird von diesem Mac entfernt und alle Einstellungen werden zurückgesetzt. Deine YouTube-Music-Mediathek und dein Google-Account bleiben unverändert."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "needs_review",
