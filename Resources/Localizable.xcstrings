    "Deletes local credentials, files and pending writes. Your Google account and remote playlists are unchanged.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Löscht lokale Zugangsdaten, Dateien und ausstehende Schreibvorgänge. Dein Google-Account und deine Remote-Playlists bleiben unverändert."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Löscht lokale Zugangsdaten, Dateien und ausstehende Schreibvorgänge. Dein Google-Account und deine Remote-Playlists bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes local credentials, files and pending writes. Your Google account and remote playlists are unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elimina las credenciales locales, los archivos y las escrituras pendientes. Tu cuenta de Google y las listas de reproducción remotas no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Supprime les identifiants locaux, les fichiers et les écritures en attente. Votre compte Google et vos playlists distantes ne sont pas modifiés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Удаляет локальные учётные данные, файлы и ожидающие записи. Ваш аккаунт Google и плейлисты на сервере не затрагиваются."
          }
        }
      },
      "comment": "Core string (W28). Every non-English value is a MACHINE SEED pending human review (W42); it is not release quality."
    },
    "Deletes this account's sign-in, downloads, cache and settings from this Mac. Your YouTube Music library, playlists and Google account are not changed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Löscht die Anmeldung, Downloads, den Cache und die Einstellungen dieses Accounts von diesem Mac. Deine YouTube-Music-Mediathek, deine Playlists und dein Google-Account bleiben unverändert."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Löscht die Anmeldung, Downloads, den Cache und die Einstellungen dieses Accounts von diesem Mac. Deine YouTube-Music-Mediathek, deine Playlists und dein Google-Account bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes this account's sign-in, downloads, cache and settings from this Mac. Your YouTube Music library, playlists and Google account are not changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elimina de este Mac el inicio de sesión, las descargas, la caché y los ajustes de esta cuenta. Tu biblioteca de YouTube Music, tus listas de reproducción y tu cuenta de Google no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Supprime de ce Mac la connexion, les téléchargements, le cache et les réglages de ce compte. Votre bibliothèque YouTube Music, vos playlists et votre compte Google ne sont pas modifiés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Удаляет вход в аккаунт, загрузки, кэш и настройки этого аккаунта с этого Mac. Ваша медиатека YouTube Music, плейлисты и аккаунт Google не затрагиваются."
          }
        }
      },
      "comment": "Core string (W28). Every non-English value is a MACHINE SEED pending human review (W42); it is not release quality."
    },
