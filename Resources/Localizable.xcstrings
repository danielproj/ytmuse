        "de-CH": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du bist offline, daher wurde nichts geändert. Die Aktion wurde nicht vorgemerkt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Δεν υπάρχει σύνδεση, επομένως δεν άλλαξε τίποτα. Η ενέργεια δεν μπήκε σε ουρά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re offline, so nothing was changed. It isn’t queued."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Estás sin conexión, así que no se ha cambiado nada. La acción no se ha puesto en cola."
          }
        },
        "et": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ühendus puudub, seega midagi ei muudetud. Toimingut ei pandud järjekorda."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lineaz kanpo zaude, beraz ez da ezer aldatu. Ekintza ez da ilaran jarri."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Olet offline-tilassa, joten mitään ei muutettu. Toimintoa ei ole asetettu jonoon."
          }
        },
        "fo": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tú ert ótengdur, so einki varð broytt. Gerðin varð ikki løgd í bíðirøð."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous êtes hors ligne, rien n’a donc été modifié. L’action n’est pas mise en attente."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tá tú as líne, mar sin níor athraíodh aon rud. Níor cuireadh an gníomh sa scuaine."
          }
        },
        "gd": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chan eil ceangal agad, mar sin cha deach dad atharrachadh. Cha deach an gnìomh a chur sa chiudha."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Estás sen conexión, así que non se cambiou nada. A acción non se puxo na cola."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Niste povezani, pa ništa nije promijenjeno. Radnja nije stavljena u red čekanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Offline van, ezért semmi sem változott. A művelet nem került sorba."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Կապ չկա, ուստի ոչինչ չի փոխվել։ Գործողությունը հերթում չի դրվել։"
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Þú ert án nettengingar, svo engu var breytt. Aðgerðin er ekki í biðröð."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sei offline, quindi non è stato modificato nulla. L’azione non è stata messa in coda."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "needs_review",
            "value": "კავშირი არ გაქვთ, ამიტომ არაფერი შეცვლილა. მოქმედება რიგში არ დამატებულა."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dir sidd offline, dofir gouf näischt geännert. D’Aktioun gouf net an d’Warteschlaang gesat."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nėra ryšio, todėl nieko nepakeista. Veiksmas neįtrauktas į eilę."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jums nav savienojuma, tāpēc nekas netika mainīts. Darbība netika ievietota rindā."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Немате врска, па ништо не е променето. Дејноста не е ставена во редица."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Int offlajn, għalhekk ma nbidel xejn. L-azzjoni ma tqiegħdetx fil-kju."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du er frakoblet, så ingenting ble endret. Handlingen er ikke satt i kø."
