    "Saved window state could not be reset safely. Your account remains usable. Try again after fixing this app’s window-state storage.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der gesicherte Fensterstatus konnte nicht sicher zurückgesetzt werden. Dein Account bleibt nutzbar. Versuche es erneut, nachdem du den Speicher für den Fensterstatus dieser App repariert hast."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "needs_review",
