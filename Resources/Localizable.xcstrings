    "A check downloads one small signed file from GitHub. It sends no account, listening or device information.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bei einer Prüfung wird eine kleine signierte Datei von GitHub geladen. Es werden keine Informationen zu Account, Wiedergabe oder Gerät gesendet."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bei einer Prüfung wird eine kleine signierte Datei von GitHub geladen. Es werden keine Informationen zu Account, Wiedergabe oder Gerät gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A check downloads one small signed file from GitHub. It sends no account, listening or device information."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una comprobación descarga un pequeño archivo firmado de GitHub. No envía información de la cuenta, de lo que escuchas ni del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une vérification télécharge un petit fichier signé depuis GitHub. Elle n’envoie aucune information sur le compte, l’écoute ou l’appareil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "При проверке загружается один небольшой подписанный файл с GitHub. Данные об аккаунте, прослушивании и устройстве не отправляются."
          }
        }
      },
      "comment": "Core string (W28). Every non-English value is a MACHINE SEED pending human review (W42); it is not release quality."
    },
    "A credential could not be read or cleaned up.": {
      "localizations": {
        "de": {
