    "Crossfade overlaps the end of one item with the start of the next, and a live stream has no end to overlap.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beim Überblenden überlappen sich das Ende eines Objekts und der Anfang des nächsten, und ein Livestream hat kein Ende, das sich überlappen ließe."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beim Überblenden überlappen sich das Ende eines Objekts und der Anfang des nächsten, und ein Livestream hat kein Ende, das sich überlappen liesse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crossfade overlaps the end of one item with the start of the next, and a live stream has no end to overlap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El fundido cruzado solapa el final de un elemento con el inicio del siguiente, y una transmisión en directo no tiene final que solapar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
