          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "YTMuse can look for a new version once a day. The check downloads one small signed file and sends no account, listening or device information. You can change this in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "YTMuse puede buscar una versión nueva una vez al día. La comprobación descarga un pequeño archivo firmado y no envía información de la cuenta, de lo que escuchas ni del dispositivo. Puedes cambiarlo en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "YTMuse peut rechercher une nouvelle version une fois par jour. La vérification télécharge un petit fichier signé et n’envoie aucune information sur le compte, l’écoute ou l’appareil. Vous pouvez modifier cela dans les Réglages."
          }
        },
        "ru": {
