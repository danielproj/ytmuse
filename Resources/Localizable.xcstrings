    "After a manual launch the last song is shown paused. Nothing plays until you press Play.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nach einem manuellen Start wird der letzte Song pausiert angezeigt. Es wird nichts abgespielt, bis du auf „Wiedergabe“ drückst."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nach einem manuellen Start wird der letzte Song pausiert angezeigt. Es wird nichts abgespielt, bis du auf „Wiedergabe“ drückst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After a manual launch the last song is shown paused. Nothing plays until you press Play."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tras un inicio manual, la última canción aparece en pausa. No suena nada hasta que pulses Reproducir."
