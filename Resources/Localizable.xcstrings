    "Recent searches and items stay on this Mac, are never sent anywhere and are removed with the account.": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Son axtarışlar və elementlər bu Mac-də qalır, heç yerə göndərilmir və hesabla birlikdə silinir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Нядаўнія запыты і аб’екты застаюцца на гэтым Mac, нікуды не адпраўляюцца і выдаляюцца разам з уліковым запісам."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Скорошните търсения и елементи остават на този Mac, никога не се изпращат никъде и се премахват заедно с профила."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nedavna pretraživanja i stavke ostaju na ovom Macu, nikada se nigdje ne šalju i brišu se zajedno s računom."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les cerques i els elements recents es queden en aquest Mac, no s’envien mai enlloc i se suprimeixen juntament amb el compte."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poslední hledání a položky zůstávají v tomto Macu, nikam se neodesílají a odstraní se spolu s účtem."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mae chwiliadau ac eitemau diweddar yn aros ar y Mac hwn, ni chânt eu hanfon i unman a chânt eu tynnu gyda'r cyfrif."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
