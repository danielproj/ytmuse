    "“%@”": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”"
          }
        }
      }
    },
    "“%@” is already here. Keep Duplicates adds it again as a separate entry; Skip Existing leaves it out.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„%@“ ist bereits hier. „Duplikate behalten“ fügt es erneut als separaten Eintrag hinzu; „Vorhandene überspringen“ lässt es weg."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„%@“ ist bereits hier. „Duplikate behalten“ fügt es erneut als separaten Eintrag hinzu; „Vorhandene überspringen“ lässt es weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is already here. Keep Duplicates adds it again as a separate entry; Skip Existing leaves it out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” ya está aquí. Conservar duplicados lo añade de nuevo como una entrada aparte; Omitir existentes lo deja fuera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "« %@ » est déjà là. « Conserver les doublons » l’ajoute à nouveau comme entrée distincte ; « Ignorer les existants » l’exclut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«%@» уже здесь. «Оставить дубликаты» добавляет его снова как отдельную запись; «Пропустить существующие» не добавляет."
          }
        }
      },
      "comment": "Core string (W28). Every non-English value is a MACHINE SEED pending human review (W42); it is not release quality."
    },
    "“%@” is no longer the song you were changing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„%@“ ist nicht mehr der Song, den du geändert hast."
          }
