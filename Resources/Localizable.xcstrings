    "Filters require this radio’s active player, readable queue and supported playback options. Restart the radio to reload its controls.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Filter benötigen den aktiven Player dieses Radios, eine lesbare Warteschlange und unterstützte Wiedergabeoptionen. Starte das Radio neu, um die Steuerelemente erneut zu laden."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "needs_review",
