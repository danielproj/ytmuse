    "Sign-in timed out. Nothing was saved. Try again when you’re ready.": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Girişin vaxtı bitdi. Heç nə saxlanmadı. Hazır olduqda yenidən cəhd edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Час уваходу скончыўся. Нічога не захавана. Паспрабуйце яшчэ раз, калі будзеце гатовыя."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Времето за вход изтече. Нищо не беше запазено. Опитайте отново, когато сте готови."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prijava je istekla. Ništa nije sačuvano. Pokušajte ponovo kada budete spremni."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’inici de sessió ha caducat. No s’ha desat res. Torna-ho a provar quan estiguis a punt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Přihlášení vypršelo. Nic nebylo uloženo. Zkuste to znovu, až budete připraveni."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Daeth y mewngofnodi i ben. Ni chadwyd dim. Rhowch gynnig arni eto pan fyddwch yn barod."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Login fik timeout. Intet blev gemt. Prøv igen, når du er klar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Anmeldung ist abgelaufen. Es wurde nichts gesichert. Versuche es erneut, wenn du bereit bist."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Anmeldung ist abgelaufen. Es wurde nichts gesichert. Versuche es erneut, wenn du bereit bist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Η σύνδεση έληξε. Δεν αποθηκεύτηκε τίποτα. Δοκιμάστε ξανά όταν είστε έτοιμοι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in timed out. Nothing was saved. Try again when you’re ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El inicio de sesión ha caducado. No se ha guardado nada. Inténtalo de nuevo cuando estés listo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sisselogimine aegus. Midagi ei salvestatud. Proovi uuesti, kui oled valmis."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saio-hasierak denbora-muga gainditu du. Ez da ezer gorde. Saiatu berriro prest zaudenean."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kirjautuminen aikakatkaistiin. Mitään ei tallennettu. Yritä uudelleen, kun olet valmis."
          }
        },
        "fo": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Innritanin fór út á tíð. Einki varð goymt. Royn aftur, tá ið tú ert klárur."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La connexion a expiré. Rien n’a été enregistré. Réessayez quand vous êtes prêt."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cuireadh an síniú isteach in éag. Níor sábháladh aon rud. Bain triail eile as nuair a bheidh tú réidh."
          }
        },
        "gd": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dh’fhalbh an ùine air a’ chlàradh a-steach. Cha deach dad a shàbhaladh. Feuch ris a-rithist nuair a bhios tu deiseil."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O inicio de sesión caducou. Non se gardou nada. Téntao de novo cando estea listo."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prijava je istekla. Ništa nije spremljeno. Pokušajte ponovo kad budete spremni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A bejelentkezés időtúllépés miatt megszakadt. Semmi sem lett mentve. Próbálja újra, ha készen áll."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Մուտքի ժամանակը սպառվեց։ Ոչինչ չի պահվել։ Կրկին փորձեք, երբ պատրաստ լինեք։"
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Innskráningin rann út á tíma. Engu var vistað. Reyndu aftur þegar þú ert tilbúin(n)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’accesso è scaduto. Non è stato salvato nulla. Riprova quando sei pronto."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "needs_review",
            "value": "შესვლის დრო ამოიწურა. არაფერი შენახულა. სცადეთ ხელახლა, როცა მზად იქნებით."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "D’Umeldung ass ofgelaf. Et gouf näischt gespäichert. Probéiert et nach eng Kéier, wann Dir prett sidd."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prisijungimo laikas baigėsi. Nieko neišsaugota. Bandykite dar kartą, kai būsite pasirengę."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pierakstīšanās laiks ir beidzies. Nekas netika saglabāts. Mēģiniet vēlreiz, kad esat gatavs."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Најавата истече. Ништо не е зачувано. Обидете се повторно кога ќе бидете подготвени."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L-idħol skada. Ma nżamm xejn. Erġa’ pprova meta tkun lest."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Påloggingen ble tidsavbrutt. Ingenting ble lagret. Prøv igjen når du er klar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inloggen is verlopen. Er is niets bewaard. Probeer het opnieuw wanneer je klaar bent."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Påloggingen vart tidsavbroten. Ingenting vart lagra. Prøv igjen når du er klar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Logowanie wygasło. Nic nie zostało zapisane. Spróbuj ponownie, gdy będziesz gotowy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O início de sessão expirou. Nada foi guardado. Tente novamente quando estiver pronto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O início de sessão expirou. Nada foi guardado. Tente novamente quando estiver pronto."
          }
        },
        "rm": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’annunzia è scrudada. Nagut n’è vegnì memorisà. Empruva danovamain cur che ti es pront."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conectarea a expirat. Nu s-a salvat nimic. Încearcă din nou când ești gata."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Время входа истекло. Ничего не сохранено. Повторите попытку, когда будете готовы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prihlásenie vypršalo. Nič sa neuložilo. Skúste to znova, keď budete pripravení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prijava je potekla. Nič ni bilo shranjeno. Poskusite znova, ko boste pripravljeni."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hyrja skadoi. Nuk u ruajt asgjë. Provoni përsëri kur të jeni gati."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пријава је истекла. Ништа није сачувано. Покушајте поново када будете спремни."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prijava je istekla. Ništa nije sačuvano. Pokušajte ponovo kada budete spremni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inloggningen gick ut. Ingenting sparades. Försök igen när du är redo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Giriş zaman aşımına uğradı. Hiçbir şey kaydedilmedi. Hazır olduğunuzda tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Час входу минув. Нічого не збережено. Спробуйте ще раз, коли будете готові."
          }
        }
      },
      "comment": "Core string (W28). Every non-English value is a MACHINE SEED pending human review (W42); it is not release quality."
